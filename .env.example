DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vintex
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
CORS_ORIGINS=*

# Autenticação JWT — ver .ai/adr/0002-autenticacao-jwt.md.
# Gere um segredo forte por ambiente; nunca reutilize o valor de exemplo em produção.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage de mídia (VE-16). Na AWS, omita S3_ENDPOINT_URL e use credenciais
# do ambiente/role padrão do boto3; no LocalStack, informe o endpoint local.
AWS_REGION=us-east-2
S3_ENDPOINT_URL=http://localhost:4566
MEDIA_BUCKET=vintex-local-media
