DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vintex
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
CORS_ORIGINS=*

# Autenticação JWT — ver .ai/adr/0002-autenticacao-jwt.md.
# Gere um segredo forte por ambiente; nunca reutilize o valor de exemplo em produção.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Conta da administradora criada por `python -m app.seeds.admin` (back-end#61).
# Vazio em desenvolvimento usa a senha documentada no README; em produção é
# obrigatório, e o seed recusa rodar sem ele.
SEED_ADMIN_EMAIL=admin@vintex.example.com
SEED_ADMIN_PASSWORD=

# Embedding do catálogo (BE-US027-1, back-end#92). AI_PROVIDER=google ativa
# o provedor real; sem chave, deixe AI_PROVIDER=unavailable (padrão).
AI_PROVIDER=unavailable
GOOGLE_API_KEY=
# UM nome so, e nao lista (back-end#227). O vetor da pergunta tem que viver no
# mesmo espaco dos vetores gravados no catalogo; cair para outro modelo
# devolveria distancia entre espacos diferentes, que e ruido com cara de
# resultado. Trocar o modelo aqui exige reprocessar o catalogo com
# scripts/backfill_embeddings.py.
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2

# Cota do chat por dia (back-end#258): por pessoa e para o projeto inteiro.
# O provedor gratuito da 50 por dia ao projeto; 40 deixa margem a analise de
# foto e ao vetor da peca publicada, que usam a mesma chave.
CHAT_QUOTA_PER_PERSON=5
CHAT_QUOTA_PER_DAY=40

# Storage de mídia (VE-16). Na AWS, omita S3_ENDPOINT_URL e use credenciais
# do ambiente/role padrão do boto3; no LocalStack, informe o endpoint local.
AWS_REGION=us-east-2
S3_ENDPOINT_URL=http://localhost:4566
MEDIA_BUCKET=vintex-local-media

# Base pública da API, usada nas URLs devolvidas ao navegador (back-end#73).
# Vazio usa a base da requisição. Se o servidor usar outra origem para baixar
# as fotos, configure MEDIA_INTERNAL_BASE_URL (ex.: http://api:8000).
PUBLIC_BASE_URL=
MEDIA_INTERNAL_BASE_URL=

# Worker #169: chave unificada do FreeLLMAPI recebida apenas no runtime.
AI_WORKER_PROVIDER=unavailable
AI_ANALYSIS_QUEUE_URL=
SQS_ENDPOINT_URL=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

# Modelo multimodal do preenchimento da peça a partir da foto (back-end#150),
# diferente do de embedding.
#
# Aceita vários nomes separados por vírgula: um 503 no primeiro faz tentar o
# próximo (back-end#209). A capacidade do provedor oscila por modelo — medido
# em 27/09, 4 falhas em 5 chamadas num intervalo de vinte minutos, com seis
# outros modelos respondendo no mesmo período. Um nome só continua valendo.
#
# A ordem importa: o primeiro é o preferido. O `flash-lite` respondeu em 2,7s
# contra 4,4s do `3.8-flash` na mesma foto.
GOOGLE_VISION_MODEL=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash
