# Projeto Compose vintex-infra (VE-12) — infraestrutura de teste local.
# Copie para .env neste mesmo diretório. Nenhum valor aqui é um segredo real:
# são credenciais fixas de desenvolvimento local, exigidas pelo Postgres e
# pelos emuladores (LocalStack/MiniStack aceitam qualquer credencial AWS
# fake nas requisições).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vintex_infra

# Portas expostas no host. Mudar aqui se colidirem com outro processo local
# (ex.: docker-compose.yml de dev na raiz usa 5433/8000).
DB_HOST_PORT=5434
API_HOST_PORT=8001
LOCALSTACK_HOST_PORT=4566
MINISTACK_HOST_PORT=4567

LOCALSTACK_DEBUG=0
